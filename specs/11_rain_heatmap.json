{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Heatmap: average monthly rainfall by state, from a 25-year NASA POWER climatology.",
  "data": {
    "url": "data/climate_states.csv",
    "format": {
      "type": "csv",
      "parse": {
        "month": "number",
        "rain_mm_month": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "replace(datum.state, 'W.P. ', '')",
      "as": "state_name"
    }
  ],
  "width": 950,
  "height": 450,
  "encoding": {
    "x": {
      "field": "month_name",
      "type": "ordinal",
      "title": null,
      "sort": [
        "Jan",
        "Feb",
        "Mar",
        "Apr",
        "May",
        "Jun",
        "Jul",
        "Aug",
        "Sep",
        "Oct",
        "Nov",
        "Dec"
      ],
      "axis": {
        "labelAngle": 0,
        "domain": false,
        "ticks": false,
        "orient": "top",
        "labelFontSize": 12,
        "labelColor": "#1C2B22",
        "labelPadding": 6
      }
    },
    "y": {
      "field": "state_name",
      "type": "nominal",
      "title": null,
      "sort": [
        "Sarawak",
        "Terengganu",
        "Pahang",
        "Sabah",
        "Labuan",
        "Selangor",
        "Kelantan",
        "Kuala Lumpur",
        "Putrajaya",
        "Perak",
        "Negeri Sembilan",
        "Johor",
        "Pulau Pinang",
        "Kedah",
        "Melaka",
        "Perlis"
      ],
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontSize": 11.5,
        "labelColor": "#1C2B22"
      }
    },
    "color": {
      "field": "rain_mm_month",
      "type": "quantitative",
      "title": "Average rainfall (millimetres per month)",
      "scale": {
        "type": "threshold",
        "domain": [
          155,
          185,
          215,
          270
        ],
        "range": [
          "#A9C8DE",
          "#7CA9CC",
          "#5089B7",
          "#2F6A9A",
          "#1C4B72"
        ]
      },
      "legend": {
        "orient": "none",
        "legendX": -95,
        "legendY": 476,
        "direction": "horizontal",
        "titleAnchor": "start",
        "titleColor": "#1C2B22",
        "labelColor": "#5E6E64",
        "titleFontSize": 11.5,
        "labelFontSize": 11.5,
        "labelOverlap": false,
        "labelPadding": 6,
        "titlePadding": 8
      }
    },
    "tooltip": [
      {
        "field": "state_name",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "city",
        "type": "nominal",
        "title": "Measured at"
      },
      {
        "field": "month_name",
        "type": "nominal",
        "title": "Month"
      },
      {
        "field": "rain_mm_month",
        "type": "quantitative",
        "title": "Rainfall (millimetres)",
        "format": ",.0f"
      },
      {
        "field": "tmax_c",
        "type": "quantitative",
        "title": "Average daily maximum (\u00b0C)",
        "format": ".1f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#FAF7F0",
        "strokeWidth": 1.5,
        "cornerRadius": 1
      }
    },
    {
      "transform": [
        {
          "filter": "datum.month == 11 && datum.state == 'Terengganu'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 9,
        "fontWeight": 700,
        "lineBreak": "|",
        "lineHeight": 10
      },
      "encoding": {
        "text": {
          "value": "North-east|monsoon"
        },
        "color": {
          "value": "#FAF7F0"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.month == 2 && datum.state == 'Perlis'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 9,
        "fontWeight": 700,
        "lineBreak": "|",
        "lineHeight": 10
      },
      "encoding": {
        "text": {
          "value": "Driest cell|on the chart"
        },
        "color": {
          "value": "#1C2B22"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
