{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Connected scatterplot: Malaysia\u2019s vegetable planted area against vegetable production, one point per year, joined in time order.",
  "data": {
    "url": "data/crops_category_malaysia.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "planted_area_ha": "number",
        "production_tonnes": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.crop_type == 'vegetables'"
    }
  ],
  "width": 900,
  "height": 380,
  "encoding": {
    "x": {
      "field": "planted_area_ha",
      "type": "quantitative",
      "title": "Planted area (hectares)",
      "scale": {
        "zero": false,
        "nice": true
      },
      "axis": {
        "grid": true,
        "gridColor": "#DCD5C7",
        "gridDash": [
          2,
          3
        ],
        "domain": false,
        "ticks": false,
        "format": ",.0f",
        "tickCount": 6,
        "labelColor": "#5E6E64",
        "titleColor": "#5E6E64"
      }
    },
    "y": {
      "field": "production_tonnes",
      "type": "quantitative",
      "title": "Production (tonnes)",
      "scale": {
        "zero": false,
        "nice": true
      },
      "axis": {
        "grid": true,
        "gridColor": "#DCD5C7",
        "gridDash": [
          2,
          3
        ],
        "domain": false,
        "ticks": false,
        "format": ",.0f",
        "labelColor": "#5E6E64",
        "titleColor": "#5E6E64"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "interpolate": "linear",
        "strokeWidth": 2,
        "color": "#4C8D48",
        "opacity": 0.8
      },
      "encoding": {
        "order": {
          "field": "year",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 150,
        "color": "#2D6C35",
        "stroke": "#FAF7F0",
        "strokeWidth": 2
      },
      "encoding": {
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "planted_area_ha",
            "type": "quantitative",
            "title": "Planted area (hectares)",
            "format": ",.0f"
          },
          {
            "field": "production_tonnes",
            "type": "quantitative",
            "title": "Production (tonnes)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year != 2019"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 11,
        "dy": -9,
        "fontSize": 11.5,
        "fontWeight": 600,
        "color": "#1C2B22"
      },
      "encoding": {
        "text": {
          "field": "year",
          "type": "quantitative",
          "format": "d"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2019"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 11,
        "dy": 17,
        "fontSize": 11.5,
        "fontWeight": 600,
        "color": "#1C2B22"
      },
      "encoding": {
        "text": {
          "field": "year",
          "type": "quantitative",
          "format": "d"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2018"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": 22,
        "fontSize": 11.5,
        "fontStyle": "italic",
        "color": "#C2603C"
      },
      "encoding": {
        "text": {
          "value": "lowest point of the decade"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2024"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -14,
        "dy": 16,
        "fontSize": 11.5,
        "fontStyle": "italic",
        "color": "#1A4A27"
      },
      "encoding": {
        "text": {
          "value": "highest in eleven years"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
