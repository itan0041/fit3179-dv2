{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Ridgeline plot: monthly Google Trends search interest in Malaysia for four gardening terms, January 2014 to September 2026. The pale band is the raw monthly index and the solid line is a five-month centred average. All four row is scaled to its own peak, so the shapes are comparable even though the terms differ greatly in volume.",
  "data": {
    "url": "data/trends_my_monthly.csv",
    "format": {
      "type": "csv",
      "parse": {
        "date": "date",
        "value": "number"
      }
    }
  },
  "transform": [
    {
      "window": [
        {
          "op": "mean",
          "field": "value",
          "as": "smooth"
        }
      ],
      "frame": [
        -2,
        2
      ],
      "groupby": [
        "keyword"
      ],
      "sort": [
        {
          "field": "date"
        }
      ]
    }
  ],
  "spacing": -62,
  "facet": {
    "row": {
      "field": "keyword",
      "type": "nominal",
      "title": null,
      "sort": [
        "hidroponik",
        "gardening",
        "berkebun",
        "kebun sayur"
      ],
      "header": {
        "labelAngle": 0,
        "labelAlign": "right",
        "labelOrient": "left",
        "labelPadding": 10,
        "labelLimit": 150,
        "labelFontSize": 12.5,
        "labelFontStyle": "italic",
        "labelColor": "#1C2B22",
        "labelBaseline": "middle"
      }
    }
  },
  "spec": {
    "width": 820,
    "height": 124,
    "layer": [
      {
        "mark": {
          "type": "area",
          "interpolate": "monotone",
          "fillOpacity": 0.72,
          "stroke": "#FAF7F0",
          "strokeWidth": 1.2,
          "line": false
        },
        "encoding": {
          "x": {
            "field": "date",
            "type": "temporal",
            "title": null,
            "axis": {
              "format": "%Y",
              "tickCount": "year",
              "grid": false,
              "domainColor": "#DCD5C7",
              "tickColor": "#DCD5C7",
              "labelColor": "#5E6E64"
            }
          },
          "y": {
            "field": "value",
            "type": "quantitative",
            "scale": {
              "zero": true
            },
            "axis": null
          },
          "color": {
            "value": "#E6AD8C"
          }
        }
      },
      {
        "mark": {
          "type": "line",
          "interpolate": "monotone",
          "strokeWidth": 1.8
        },
        "encoding": {
          "x": {
            "field": "date",
            "type": "temporal"
          },
          "y": {
            "field": "smooth",
            "type": "quantitative",
            "scale": {
              "zero": true
            },
            "axis": null
          },
          "color": {
            "value": "#9E4528"
          },
          "tooltip": [
            {
              "field": "keyword_label",
              "type": "nominal",
              "title": "Search term"
            },
            {
              "field": "date",
              "type": "temporal",
              "title": "Month",
              "format": "%B %Y"
            },
            {
              "field": "value",
              "type": "quantitative",
              "title": "Interest that month (0-100)"
            },
            {
              "field": "smooth",
              "type": "quantitative",
              "title": "Five-month average",
              "format": ".1f"
            }
          ]
        }
      },
      {
        "data": {
          "values": [
            {
              "date": "2020-03-18"
            }
          ]
        },
        "mark": {
          "type": "rule",
          "color": "#1C2B22",
          "strokeDash": [
            4,
            3
          ],
          "strokeWidth": 1.1,
          "opacity": 0.75
        },
        "encoding": {
          "x": {
            "field": "date",
            "type": "temporal"
          }
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "y": "independent",
      "x": "shared"
    }
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}
