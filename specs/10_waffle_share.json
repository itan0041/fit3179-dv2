{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Waffle chart: each of the 100 squares is one per cent of Malaysia\u2019s vegetable planted area in 2024.",
  "data": {
    "url": "data/waffle_vegetable_share.csv",
    "format": {
      "type": "csv",
      "parse": {
        "row": "number",
        "col": "number",
        "share_pct": "number",
        "squares": "number"
      }
    }
  },
  "width": 482,
  "height": 482,
  "layer": [
    {
      "mark": {
        "type": "square",
        "size": 1330,
        "stroke": "#FAF7F0",
        "strokeWidth": 3.4,
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal",
          "axis": null
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "axis": null
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "title": "State",
          "scale": {
            "domain": [
              "Pahang",
              "Johor",
              "Kelantan",
              "Sarawak",
              "Perak",
              "Sabah",
              "Other states"
            ],
            "range": [
              "#17401F",
              "#38763E",
              "#6BA45F",
              "#9CC78B",
              "#C6DEB8",
              "#E4EFDA",
              "#D6CEBC"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 4,
            "titleColor": "#1C2B22",
            "labelColor": "#5E6E64",
            "titleOrient": "top",
            "symbolType": "square",
            "symbolSize": 150,
            "labelFontSize": 11.5,
            "columnPadding": 14,
            "rowPadding": 5,
            "offset": 10
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Share of national area (per cent)",
            "format": ".1f"
          },
          {
            "field": "squares",
            "type": "quantitative",
            "title": "Squares on this chart"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "col": 0,
            "row": 1
          },
          {
            "col": 1,
            "row": 1
          },
          {
            "col": 2,
            "row": 1
          },
          {
            "col": 3,
            "row": 1
          }
        ]
      },
      "transform": [],
      "mark": {
        "type": "rect",
        "fill": "#17401F",
        "stroke": null,
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal"
        },
        "y": {
          "field": "row",
          "type": "ordinal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "col": 0,
            "row": 1,
            "label": "Pahang: 36 squares"
          }
        ]
      },
      "transform": [],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": -18,
        "fontSize": 13.5,
        "fontWeight": 700,
        "color": "#FAF7F0"
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal"
        },
        "y": {
          "field": "row",
          "type": "ordinal"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "col": 0,
            "row": 9,
            "label": "Every other state combined: 12"
          }
        ]
      },
      "transform": [],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 0,
        "fontSize": 11.5,
        "fontWeight": 600,
        "color": "#1C2B22"
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal"
        },
        "y": {
          "field": "row",
          "type": "ordinal"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
