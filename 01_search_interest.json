{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Multi-line chart: monthly Google Trends search interest in Malaysia for four gardening terms, January 2014 to September 2026, all on one 0-100 scale so the terms can be compared directly. Lines are a five-month centred average, which shows the trend through month-to-month noise.",
  "data": {
    "url": "data/trends_my_monthly.csv",
    "format": {
      "type": "csv",
      "parse": {
        "date": "date",
        "value": "number"
      }
    }
  },
  "transform": [
    {
      "window": [
        {
          "op": "mean",
          "field": "value",
          "as": "smooth"
        }
      ],
      "frame": [
        -2,
        2
      ],
      "groupby": [
        "keyword"
      ],
      "sort": [
        {
          "field": "date"
        }
      ]
    }
  ],
  "width": 925,
  "height": 384,
  "padding": {
    "left": 5,
    "top": 5,
    "bottom": 5,
    "right": 8
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": null,
      "axis": {
        "format": "%Y",
        "tickCount": "year",
        "grid": false,
        "domainColor": "#DCD5C7",
        "tickColor": "#DCD5C7",
        "labelColor": "#5E6E64",
        "labelFontSize": 11.5
      }
    },
    "y": {
      "field": "smooth",
      "type": "quantitative",
      "title": "Search interest (100 = busiest month of any term)",
      "scale": {
        "domain": [
          0,
          75
        ]
      },
      "axis": {
        "grid": true,
        "gridColor": "#DCD5C7",
        "gridDash": [
          2,
          3
        ],
        "domain": false,
        "ticks": false,
        "labelColor": "#5E6E64",
        "titleColor": "#5E6E64"
      }
    },
    "color": {
      "field": "keyword_label",
      "type": "nominal",
      "legend": null,
      "scale": {
        "domain": [
          "hidroponik (hydroponics)",
          "gardening",
          "berkebun (to garden)",
          "kebun sayur (vegetable garden)"
        ],
        "range": [
          "#B0502E",
          "#C2603C",
          "#D08C62",
          "#E0B18F"
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.6,
        "interpolate": "monotone"
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hover",
            "value": 1,
            "empty": true
          },
          "value": 0.2
        },
        "tooltip": [
          {
            "field": "keyword_label",
            "type": "nominal",
            "title": "Search term"
          },
          {
            "field": "date",
            "type": "temporal",
            "title": "Month",
            "format": "%B %Y"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Interest that month"
          },
          {
            "field": "smooth",
            "type": "quantitative",
            "title": "Five-month average",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "keyword_label"
            ],
            "on": "pointerover",
            "clear": "pointerout",
            "nearest": true
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 120,
        "opacity": 0
      },
      "encoding": {
        "tooltip": [
          {
            "field": "keyword_label",
            "type": "nominal",
            "title": "Search term"
          },
          {
            "field": "date",
            "type": "temporal",
            "title": "Month",
            "format": "%B %Y"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Interest that month"
          },
          {
            "field": "smooth",
            "type": "quantitative",
            "title": "Five-month average",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.date >= toDate(\"2026-09-01\")"
        },
        {
          "calculate": "datum.keyword === 'kebun sayur' ? datum.smooth - 4.5 : (datum.keyword === 'berkebun' ? datum.smooth + 2.5 : datum.smooth)",
          "as": "label_y"
        },
        {
          "calculate": "split(datum.keyword_label, ' (')[0]",
          "as": "label_short"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 12.5,
        "fontWeight": 600
      },
      "encoding": {
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "field": "label_short",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "date": "2020-03-18"
          }
        ]
      },
      "transform": [],
      "mark": {
        "type": "rule",
        "strokeDash": [
          5,
          4
        ],
        "strokeWidth": 1.4,
        "opacity": 0.55
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "y": null,
        "color": {
          "value": "#1C2B22"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "date": "2020-04-15",
            "y": 73,
            "label": "Movement Control Order, March 2020"
          }
        ]
      },
      "transform": [],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "baseline": "top",
        "fontSize": 11.5,
        "fontStyle": "italic"
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "color": {
          "value": "#5E6E64"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
